import("//flutter/common/config.gni")

# The Elpian VM plus the optional Dart/Flutter host surface, built from the Rust
# crate `dart` as a static library. Produced out-of-tree by:
#   cd elpian && cargo build -p dart --release            # with the Dart extras
# and staged as libdart.a. This target links it and exposes the C ABI. Build with
# `--no-default-features` for a VM-only artifact without the Dart extras.
config("elpian_vm_config") {
  libs = [ "dart" ]
  lib_dirs = [ rebase_path("//../../elpian/target/release") ]
}

source_set("elpian_runtime") {
  sources = [
    "elpian_ffi.h",
    "elpian_runtime.cc",
    "elpian_runtime.h",
  ]

  deps = [
    "//flutter/display_list",
    "//flutter/fml",
    "//flutter/third_party/rapidjson",
  ]

  public_configs = [ "//flutter:config" ]
  all_dependent_configs = [ ":elpian_vm_config" ]
}
